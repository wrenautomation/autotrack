{
  "name": "@wrenautomation/autotrack",
  "version": "0.3.0",
  "description": "Records every input and the screen around it on Mac, Windows and Linux, for computer-use training data.",
  "private": true,
  "type": "module",
  "bin": {
    "autotrack": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "autotrack": "node --experimental-strip-types src/cli.ts",
    "lint": "biome check .",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "koffi": "2.16.3",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "license": "PolyForm-Strict-1.0.0",
  "files": [
    "dist",
    "helpers",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE.md"
  ]
}
